<?xml version="1.0" encoding="UTF-8"?>
<sbml xmlns="http://www.sbml.org/sbml/level3/version2/core" level="3" version="2">
  <annotation>
    <SimBiology xmlns="http://www.mathworks.com">
      <Version Major="26" Minor="1" Point="0"/>
    </SimBiology>
  </annotation>
  <model id="ERModule" name="ERModule">
    <listOfUnitDefinitions>
      <unitDefinition id="MWBUILTINUNIT_liter" name="liter">
        <listOfUnits>
          <unit kind="metre" exponent="3" scale="0" multiplier="1"/>
          <unit kind="dimensionless" exponent="1" scale="0" multiplier="0.001"/>
        </listOfUnits>
      </unitDefinition>
      <unitDefinition id="MWBUILTINPREFIX_nano_MWBUILTINUNIT_molarity" name="nanomolarity">
        <listOfUnits>
          <unit kind="metre" exponent="-3" scale="0" multiplier="1"/>
          <unit kind="mole" exponent="1" scale="0" multiplier="1"/>
          <unit kind="dimensionless" exponent="1" scale="0" multiplier="1e-06"/>
        </listOfUnits>
      </unitDefinition>
      <unitDefinition id="MWDERIVEDUNIT_nanomolarity_liter" name="(nanomolarity)*(liter)">
        <listOfUnits>
          <unit kind="mole" exponent="1" scale="0" multiplier="1e-09"/>
        </listOfUnits>
      </unitDefinition>
      <unitDefinition id="MWBUILTINPREFIX_micro_MWBUILTINUNIT_molarity" name="micromolarity">
        <listOfUnits>
          <unit kind="metre" exponent="-3" scale="0" multiplier="1"/>
          <unit kind="mole" exponent="1" scale="0" multiplier="1"/>
          <unit kind="dimensionless" exponent="1" scale="0" multiplier="0.001"/>
        </listOfUnits>
      </unitDefinition>
      <unitDefinition id="MWDERIVEDUNIT_nanomolarity__hour" name="nanomolarity/hour">
        <listOfUnits>
          <unit kind="metre" exponent="-3" scale="0" multiplier="1"/>
          <unit kind="mole" exponent="1" scale="0" multiplier="1"/>
          <unit kind="second" exponent="-1" scale="0" multiplier="1"/>
          <unit kind="dimensionless" exponent="1" scale="0" multiplier="2.77777777777778e-10"/>
        </listOfUnits>
      </unitDefinition>
      <unitDefinition id="MWDERIVEDUNIT_1__hour" name="1/hour">
        <listOfUnits>
          <unit kind="second" exponent="-1" scale="0" multiplier="1"/>
          <unit kind="dimensionless" exponent="1" scale="0" multiplier="0.000277777777777778"/>
        </listOfUnits>
      </unitDefinition>
    </listOfUnitDefinitions>
    <listOfCompartments>
      <compartment id="cell" name="cell" spatialDimensions="3" size="1" units="MWBUILTINUNIT_liter" constant="true"/>
    </listOfCompartments>
    <listOfSpecies>
      <species id="cell_TIP_er" name="TIP_er" compartment="cell" initialConcentration="0" substanceUnits="MWDERIVEDUNIT_nanomolarity_liter" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false">
        <annotation>
          <SimBiology xmlns="http://www.mathworks.com">
            <Unit Numerator="nanomolarity"/>
          </SimBiology>
        </annotation>
      </species>
      <species id="cell_A_er" name="A_er" compartment="cell" initialAmount="0" substanceUnits="dimensionless" hasOnlySubstanceUnits="true" boundaryCondition="false" constant="false"/>
      <species id="cell_X_er" name="X_er" compartment="cell" initialAmount="0" substanceUnits="dimensionless" hasOnlySubstanceUnits="true" boundaryCondition="false" constant="false"/>
      <species id="cell_R_imm" name="R_imm" compartment="cell" initialAmount="0" substanceUnits="dimensionless" hasOnlySubstanceUnits="true" boundaryCondition="false" constant="false"/>
      <species id="cell_R_mat" name="R_mat" compartment="cell" initialAmount="0" substanceUnits="dimensionless" hasOnlySubstanceUnits="true" boundaryCondition="false" constant="false"/>
    </listOfSpecies>
    <listOfParameters>
      <parameter id="S_er" name="S_er" value="100" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_molarity" constant="true"/>
      <parameter id="K_act_er" name="K_act_er" value="2345.3" units="MWBUILTINPREFIX_micro_MWBUILTINUNIT_molarity" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">CALIBRATED: Hill fit to 4 Pincus peak-splicing dose points (1500/2200/3300/5000 uM). Analogous to Delaunay Fig.2C densitometry for ox, independent of beta_basal/beta_max. CAVEAT: 1500uM (&quot;&lt;10%&quot;) and 5000uM (&quot;saturation&quot;) response values were estimated from paper text, not read precisely from a figure -- verify if more precise numbers available.</body>
        </notes>
      </parameter>
      <parameter id="n_er" name="n_er" value="3.97" units="dimensionless" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">CALIBRATED: same fit as K_act_er, resnorm=0.0103. Independently confirms earlier hand-calculated estimate (2.7-5.7 range from Pincus 4-point analysis).</body>
        </notes>
      </parameter>
      <parameter id="beta_basal_er" name="beta_basal_er" value="0.77" units="MWDERIVEDUNIT_nanomolarity__hour" constant="true"/>
      <parameter id="beta_max_er" name="beta_max_er" value="25" units="MWDERIVEDUNIT_nanomolarity__hour" constant="true"/>
      <parameter id="k_deg_TIP" name="k_deg_TIP" value="1" units="MWDERIVEDUNIT_1__hour" constant="true"/>
      <parameter id="mu" name="mu" value="0.35" units="MWDERIVEDUNIT_1__hour" constant="true"/>
      <parameter id="k_on_er" name="k_on_er" value="7.2" units="MWDERIVEDUNIT_1__hour" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">PENDING - fit from Pincus 2010 HAC1 splicing Northern blot time course, Step 6-7</body>
        </notes>
      </parameter>
      <parameter id="k_off_er" name="k_off_er" value="11.09" units="MWDERIVEDUNIT_1__hour" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">PENDING - same source</body>
        </notes>
      </parameter>
      <parameter id="k_x_er" name="k_x_er" value="1" units="MWDERIVEDUNIT_1__hour" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">FIXED BY CONSTRUCTION - normalization constant (structural non-identifiability with k_off/d_x), never fit, see identifiability check Step 8</body>
        </notes>
      </parameter>
      <parameter id="d_x_er" name="d_x_er" value="0" units="MWDERIVEDUNIT_1__hour" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">PENDING - same source. OPEN QUESTION: linear decay dX/dt=k_x*A-d_x*X gives only PARTIAL adaptation (dose-dependent steady state), not perfect adaptation. Marifylli flagged same issue for ox module. Digitized Pincus Fig1C data (Step 6) shows NEAR-perfect adaptation (1.5mM: 6.3% at 240min, 2.2mM: 7.8% at 240min) - small residual difference, check if linear model reproduces this or needs saturating form.</body>
        </notes>
      </parameter>
      <parameter id="k_mat_er" name="k_mat_er" value="0.884868741140356" units="MWDERIVEDUNIT_1__hour" constant="true">
        <notes>
          <body xmlns="http://www.w3.org/1999/xhtml">Reused from Khmelinskii 2012 tandem timer kinetics (mCherry maturation half-time T=47min total, per papers own convention M=ln(2)/m). Consistent with Fisher model k_gfp/k_mch.</body>
        </notes>
      </parameter>
    </listOfParameters>
    <listOfRules>
      <rateRule variable="cell_A_er">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <minus/>
            <apply>
              <times/>
              <ci> k_on_er </ci>
              <apply>
                <divide/>
                <apply>
                  <power/>
                  <ci> S_er </ci>
                  <ci> n_er </ci>
                </apply>
                <apply>
                  <plus/>
                  <apply>
                    <power/>
                    <ci> K_act_er </ci>
                    <ci> n_er </ci>
                  </apply>
                  <apply>
                    <power/>
                    <ci> S_er </ci>
                    <ci> n_er </ci>
                  </apply>
                </apply>
              </apply>
              <apply>
                <minus/>
                <cn type="integer"> 1 </cn>
                <ci> cell_A_er </ci>
              </apply>
            </apply>
            <apply>
              <times/>
              <ci> k_off_er </ci>
              <ci> cell_A_er </ci>
              <ci> cell_X_er </ci>
            </apply>
          </apply>
        </math>
      </rateRule>
      <rateRule variable="cell_X_er">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <minus/>
            <apply>
              <times/>
              <ci> k_x_er </ci>
              <ci> cell_A_er </ci>
            </apply>
            <apply>
              <times/>
              <ci> d_x_er </ci>
              <ci> cell_X_er </ci>
            </apply>
          </apply>
        </math>
      </rateRule>
      <rateRule variable="cell_R_imm">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <minus/>
            <apply>
              <minus/>
              <apply>
                <plus/>
                <ci> beta_basal_er </ci>
                <apply>
                  <times/>
                  <apply>
                    <minus/>
                    <ci> beta_max_er </ci>
                    <ci> beta_basal_er </ci>
                  </apply>
                  <ci> cell_A_er </ci>
                </apply>
              </apply>
              <apply>
                <times/>
                <ci> k_mat_er </ci>
                <ci> cell_R_imm </ci>
              </apply>
            </apply>
            <apply>
              <times/>
              <ci> mu </ci>
              <ci> cell_R_imm </ci>
            </apply>
          </apply>
        </math>
      </rateRule>
      <rateRule variable="cell_R_mat">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <minus/>
            <apply>
              <times/>
              <ci> k_mat_er </ci>
              <ci> cell_R_imm </ci>
            </apply>
            <apply>
              <times/>
              <ci> mu </ci>
              <ci> cell_R_mat </ci>
            </apply>
          </apply>
        </math>
      </rateRule>
    </listOfRules>
    <listOfReactions>
      <reaction id="Reaction_1" name="Reaction_1" reversible="false">
        <listOfProducts>
          <speciesReference species="cell_TIP_er" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <listOfModifiers>
          <modifierSpeciesReference species="cell_A_er"/>
        </listOfModifiers>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <apply>
                <plus/>
                <ci> beta_basal_er </ci>
                <apply>
                  <times/>
                  <apply>
                    <minus/>
                    <ci> beta_max_er </ci>
                    <ci> beta_basal_er </ci>
                  </apply>
                  <ci> cell_A_er </ci>
                </apply>
              </apply>
              <ci> cell </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="Reaction_2" name="Reaction_2" reversible="false">
        <listOfReactants>
          <speciesReference species="cell_TIP_er" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <apply>
                <plus/>
                <ci> k_deg_TIP </ci>
                <ci> mu </ci>
              </apply>
              <ci> cell_TIP_er </ci>
              <ci> cell </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
    </listOfReactions>
  </model>
</sbml>
